# ─────────────────────────────────────────────────────────────
# CONROY backend environment
# Copy to ".env" and fill in the values from your Supabase project:
#   Supabase Dashboard → Project Settings → API
# ─────────────────────────────────────────────────────────────

# Project URL, e.g. https://abcdefghijklmno.supabase.co
SUPABASE_URL=

# "anon / public" key — safe for clients, respects Row Level Security.
SUPABASE_ANON_KEY=

# "service_role" key — SECRET. Bypasses RLS. Server-side only, never expose.
SUPABASE_SERVICE_ROLE_KEY=

# API server
PORT=4000
NODE_ENV=development

# Comma-separated list of origins allowed to call this API (the frontend).
CORS_ORIGINS=http://localhost:3000

# Phone OTP login. Mock mode = no real SMS; sign in with OTP_TEST_CODE.
# Set OTP_MOCK=false (and configure a Supabase SMS provider) for real SMS.
OTP_MOCK=true
OTP_TEST_CODE=123456
OTP_DEFAULT_COUNTRY_CODE=+91

# WhatsApp Cloud API OTP (sends the code on WhatsApp from your Business number —
# NO SMS, so NO India DLT needed; free ~1,000 conversations/month). Get these
# from Meta → developers.facebook.com → your App → WhatsApp → API Setup.
#   WHATSAPP_PHONE_NUMBER_ID — the sender number's ID (NOT the phone number).
#   WHATSAPP_ACCESS_TOKEN    — a permanent System User token (SECRET).
#   WHATSAPP_TEMPLATE_NAME   — an approved "Authentication" template's name.
#   WHATSAPP_TEMPLATE_LANG   — its language code, e.g. en_US.
#   WHATSAPP_OTP_BUTTON      — true if the template has a copy-code button (default).
# Set OTP_MOCK=false once these are filled in. Takes priority over Twilio/Supabase.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=en_US
WHATSAPP_OTP_BUTTON=true

# WhatsApp order-lifecycle notifications. Sent from the SAME number and token as
# OTP above, but through their own approved "Utility" templates — one message per
# event, once per order:
#   order placed → shipped → out for delivery → delivered
#   order cancelled, refund initiated, refund completed
#
# Each template's variables are positional ({{1}}, {{2}}, …) and MUST match what
# the server sends, or Meta rejects the message (error 132000). What the server
# sends per event is defined in src/lib/orderNotifications.ts; verify it against
# your live templates with:
#     GET /api/admin/whatsapp/templates      (needs WHATSAPP_BUSINESS_ACCOUNT_ID)
# and send yourself a sample of any one event with:
#     POST /api/admin/whatsapp/notify-test  { "to": "+91…", "event": "order_shipped" }
#
# Run supabase/whatsapp-notifications.sql before going live — that table is both
# the audit log and the "don't message the same customer twice" guard.
#
#   WHATSAPP_NOTIFY_ENABLED      — false silences every lifecycle message (OTP unaffected).
#   WHATSAPP_NOTIFY_LANG         — the notification templates' language; empty → WHATSAPP_TEMPLATE_LANG.
#   WHATSAPP_BUSINESS_ACCOUNT_ID — WhatsApp Manager → Account tools → WhatsApp Business Account ID.
#                                  Only used to read templates back for verification.
WHATSAPP_NOTIFY_ENABLED=true
WHATSAPP_NOTIFY_LANG=
WHATSAPP_BUSINESS_ACCOUNT_ID=
# Template names — change these here if you rename a template in WhatsApp Manager.
WHATSAPP_TPL_ORDER_CONFIRMED=conroy_order_confirmed
WHATSAPP_TPL_ORDER_SHIPPED=conroy_order_shipped
WHATSAPP_TPL_ORDER_OUT_FOR_DELIVERY=conroy_order_out_for_delivery
WHATSAPP_TPL_ORDER_DELIVERED=conroy_order_delivered
WHATSAPP_TPL_ORDER_CANCELLED=conroy_order_cancelled
WHATSAPP_TPL_REFUND_INITIATED=conroy_refund_initiated
WHATSAPP_TPL_REFUND_COMPLETED=conroy_refund_completed

# Twilio OTP (real SMS, sent directly from the backend). From Twilio Console →
# Account → API keys & tokens. Set OTP_MOCK=false once these are filled in.
#   TWILIO_FROM  — a Twilio phone number you OWN (e.g. your trial number, +1…).
#                  A personal mobile number will NOT work as a sender (err 21606).
#   Alternatively set TWILIO_MESSAGING_SERVICE_SID (leave FROM blank) to send via
#   a Messaging Service — that service must have a number in its Sender Pool.
# Trial accounts can only deliver to numbers added under Verified Caller IDs, and
# delivery to Indian numbers may require DLT registration.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_MESSAGING_SERVICE_SID=

# MSG91 OTP (legacy — no longer used; kept for reference).
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_OTP_LENGTH=6
MSG91_OTP_EXPIRY_MIN=10

# Razorpay online payments. From Razorpay Dashboard → Settings → API Keys.
# Both must be set for live checkout; if blank, checkout falls back to free
# demo mode (order is recorded, no real charge). KEY_SECRET is SECRET — never
# expose it to the frontend (the frontend only receives KEY_ID from the API).
# Use rzp_test_… keys while testing, rzp_live_… when you go live.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# SMTP for the welcome email. Unset → emails are logged (mock), not sent.
# Works with Gmail (app password), MSG91 SMTP, Brevo, etc.
# Ignored if FIREBASE_* below is set — Firebase takes priority when configured.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="CONROY <no-reply@conroy.global>"

# Firebase: send email via the "Trigger Email" Firestore extension instead of
# SMTP directly (the extension still needs its own SMTP provider configured
# at install time — Firebase has no mail servers of its own). From Firebase
# console → Project settings → Service accounts → Generate new private key.
# Paste FIREBASE_PRIVATE_KEY exactly as it appears in the downloaded JSON,
# quotes included.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_MAIL_COLLECTION=mail

# Admin panel key. Set a strong secret; enter it at /admin/login to manage the
# store. If left blank, the /admin API is OPEN (dev only).
ADMIN_KEY=

# Delhivery (courier). Unlike the keys above, put the REAL values only in a
# gitignored .env.local (local dev) and the Vercel dashboard (production) —
# never in a committed .env. Leave these blank here; shipment creation is
# simply disabled until they're set.
DELHIVERY_API_URL=
DELHIVERY_API_TOKEN=
DELHIVERY_CLIENT_NAME=
DELHIVERY_PICKUP_LOCATION=
# Long random string — no shared-secret webhook signature available on this
# account, so this path segment IS the secret. Generate with e.g.
# `node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"`
DELHIVERY_WEBHOOK_TOKEN=
# Vercel sends this automatically as a Bearer token on cron-triggered requests.
CRON_SECRET=
