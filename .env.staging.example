# ─────────────────────────────────────────────────────────────────────────────
# CONROY backend — STAGING environment
#
# This branch does NOT ship a committed `.env` (production's does, and carrying
# it here would put live keys in the test deployment). Every value below is set
# in the staging host's dashboard instead — Vercel → the staging project →
# Settings → Environment Variables.
#
# Copy to `.env.local` for a local staging run. `.env.local` is gitignored.
# ─────────────────────────────────────────────────────────────────────────────

# ── What makes this deployment staging ───────────────────────────────────────
# The only switch. Absent or anything else = behaves exactly like production.
APP_ENV=staging

# Flat per-unit price in whole rupees, applied to every product and to the
# amount Razorpay charges. This is the ₹1 test order. Ignored unless
# APP_ENV=staging. Leave unset to use the staging database's real prices.
STAGING_PRICE_OVERRIDE_INR=1

# ── Staging Supabase project (NOT production) ────────────────────────────────
# From the STAGING project → Project Settings → API.
# The server refuses to boot if these point at the production project ref.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Production project refs this build must never touch. Defaults to the known
# production ref; only set this if a second production project is added.
PRODUCTION_SUPABASE_REFS=

# ── API server ───────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=production

# The staging frontend's origin — and only it. Production's origin is
# deliberately absent so the live storefront can never call this API.
CORS_ORIGINS=https://conroy-staging.vercel.app

# ── Login ────────────────────────────────────────────────────────────────────
# Mock OTP: no SMS or WhatsApp message is sent and OTP_TEST_CODE is accepted for
# any phone number, so the client can sign in as anyone without a real handset
# and without spending WhatsApp conversation credit. This is the intended
# staging setting — set OTP_MOCK=false only to rehearse real message delivery.
OTP_MOCK=true
OTP_TEST_CODE=123456
OTP_DEFAULT_COUNTRY_CODE=+91

# Leave the real OTP providers blank in staging.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=en_US
WHATSAPP_OTP_BUTTON=true
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_MESSAGING_SERVICE_SID=

# ── Payments — TEST MODE ONLY ────────────────────────────────────────────────
# Razorpay Dashboard → toggle to Test Mode → Settings → API Keys → Generate.
# The pair MUST start with rzp_test_. The server refuses to boot on an
# rzp_live_ key while APP_ENV=staging, so a live charge cannot happen here.
# Test cards: https://razorpay.com/docs/payments/payments/test-card-details/
#   success → 4111 1111 1111 1111, any future expiry, any CVV, OTP 1234
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Deliberately take REAL money from this staging deployment.
# Leave unset. With it unset an rzp_live_ key refuses to boot, which is the
# behaviour you want: a staging order should be a sandbox transaction.
# Set to true ONLY for a real-money rehearsal — every checkout then charges a
# real card or UPI account for a ₹1 order recorded in the STAGING database,
# invisible to the production admin, and refundable only by hand from the
# Razorpay dashboard. The storefront banner turns red and says so.
STAGING_ALLOW_LIVE_PAYMENTS=

# ── Email ────────────────────────────────────────────────────────────────────
# Blank = welcome/transactional email is logged, not sent. Correct for staging:
# test orders should not email anyone. Fill in only to rehearse delivery.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="CONROY Staging <no-reply@conroy.global>"
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_MAIL_COLLECTION=mail

# ── Admin panel ──────────────────────────────────────────────────────────────
# A DIFFERENT key from production's — this one gets shared with the client so
# they can watch the order land and move it through the delivery statuses.
ADMIN_KEY=

# ── Courier (Delhivery) ──────────────────────────────────────────────────────
# Leave blank. Shipment creation is then disabled and orders stay in the
# app's own status flow — nothing is booked with the real courier, and no test
# parcel is ever dispatched. Fill these in ONLY with Delhivery staging
# credentials, never the production token.
DELHIVERY_API_URL=
DELHIVERY_API_TOKEN=
DELHIVERY_CLIENT_NAME=
DELHIVERY_PICKUP_LOCATION=
# Webhook path segment — this IS the secret. Generate a fresh one for staging:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# Staging webhook URL: <staging api>/api/webhooks/delhivery/<this value>
DELHIVERY_WEBHOOK_TOKEN=

# Vercel Cron bearer token for /api/jobs/shipment/run. Generate a fresh one.
CRON_SECRET=
